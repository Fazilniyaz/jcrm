# /etc/nginx/jadvix-proxy-params
#
# Shared by every location in the jadvix site.

proxy_http_version 1.1;

# Required for the keepalive pools in the upstream blocks: HTTP/1.1 defaults to
# keep-alive, and an inherited "Connection: close" from the client would close
# the upstream socket after every request.
proxy_set_header Connection "";

proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;

# The API reads X-Forwarded-For for its rate limiter, but ONLY when
# TRUST_PROXY=1 — see src/app.ts. Set both together or neither: trusting the
# header without a proxy lets any client claim any address, and setting the
# header without trusting it means every request is rate-limited as one IP.
